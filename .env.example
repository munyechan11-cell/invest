# ─────────────────────────────────────────────────────────────────────────
# Nothing here is required to run a backtest on synthetic data:
#   python -m quant backtest configs/demo.yaml
# Fill in only what the venues and providers you actually use need.
# ─────────────────────────────────────────────────────────────────────────

# ── control API ──────────────────────────────────────────────────────────
# Shared bearer token for `quant serve`. Leave blank ONLY when bound to
# localhost — the API can start and stop a live trading bot.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QUANT_API_TOKEN=
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=            # set to "json" for structured logs
DB_PATH=quant_state.db

# ── market data ──────────────────────────────────────────────────────────
# Yahoo needs no key. Set these only for the providers you configure.

# Korea Investment & Securities — KOSPI/KOSDAQ data and Korean equity orders
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=          # 8-digit account number
KIS_ACCOUNT_PRD_CD=01

# Alpaca — US equities and crypto (paper endpoint unless mode is live)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Crypto exchange credentials are set per-strategy in the config's
# broker.params / data.params, so several venues can coexist. Reference them
# with ${VAR} interpolation, e.g.  api_key: ${BINANCE_KEY}
BINANCE_KEY=
BINANCE_SECRET=

# ── LLM research council (optional alpha model) ──────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── notifications (optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
